[Unit]
Description=LucrumTech contact form backend
After=network.target

[Service]
Type=simple
User=lucrumtech
WorkingDirectory=/var/www/lucrumtech.com/server
EnvironmentFile=/var/www/lucrumtech.com/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
