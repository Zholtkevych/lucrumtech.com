# Example server block for lucrumtech.com.
# Adjust paths, domain and TLS cert lines to match your VPS, then drop this
# into /etc/nginx/sites-available/lucrumtech.com and symlink into sites-enabled.

server {
    listen 80;
    listen [::]:80;
    server_name lucrumtech.com www.lucrumtech.com;

    # If using certbot/Let's Encrypt, it will add its own 443 block and
    # redirect here automatically on first run.

    root /var/www/lucrumtech.com/dist;
    index index.html;

    # Static Astro build: clean URLs (e.g. /services -> /services/index.html)
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Contact form backend — proxied to the Node service (see
    # deploy/lucrumtech-contact.service). Everything else on the site is
    # static; only this path talks to a running process.
    location /api/ {
        proxy_pass http://127.0.0.1:4310/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache static assets aggressively; HTML stays revalidated.
    location ~* \.(?:css|js|svg|png|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}
