---
import { DEFAULT_LOCALE, localePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = UI[locale];

const links = [
  { route: '/services', label: t.nav.services },
  { route: '/ai', label: t.nav.ai },
  { route: '/organisation', label: t.nav.organisation },
  { route: '/work', label: t.nav.work },
  { route: '/about', label: t.nav.about },
  { route: '/interim', label: t.nav.interim },
  { route: '/contact', label: t.nav.contact },
  { route: '/privacy', label: t.footer.privacy },
];
---
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-contact">
        <a href="mailto:hello@lucrumtech.com" class="foot-mail">hello@lucrumtech.com</a>
        <span class="foot-note">{t.footer.contactLabel}</span>
        <a
          class="foot-social"
          href="https://www.linkedin.com/company/lucrumtech-your-product-partner/"
          target="_blank"
          rel="noopener"
        >LinkedIn →</a>
      </div>
      <nav class="foot-links" aria-label="Footer">
        {links.map((l) => <a href={localePath(locale, l.route)}>{l.label}</a>)}
      </nav>
    </div>
    <div class="footrow">
      <span>{t.footer.copyright}</span>
      <span>{t.footer.tagline}</span>
    </div>
  </div>
</footer>

<style>
  .foot-top{display:flex; gap:40px; justify-content:space-between; flex-wrap:wrap;
            padding:34px 0 26px; border-bottom:1px solid var(--line-soft)}
  .foot-mail{display:block; color:var(--t1); font-size:19px; font-weight:600;
             text-decoration:underline; text-underline-offset:4px}
  .foot-mail:hover{color:var(--accent)}
  .foot-note{display:block; margin-top:6px; font-size:14px; color:var(--t3)}
  .foot-social{display:inline-block; margin-top:14px; font-size:15px; font-weight:600;
               color:var(--t2); text-decoration:none;
               border-bottom:1px solid var(--line); padding-bottom:2px}
  .foot-social:hover{color:var(--accent); border-bottom-color:var(--accent)}
  .foot-links{display:flex; gap:10px 22px; flex-wrap:wrap; align-items:flex-start; max-width:560px}
  .foot-links a{font-size:15px; color:var(--t2); text-decoration:none;
                border-bottom:1px solid transparent; padding-bottom:1px}
  .foot-links a:hover{color:var(--t1); border-bottom-color:var(--line)}
  @media (max-width:640px){
    .foot-top{gap:24px; padding:26px 0 20px}
    .foot-links{gap:8px 18px}
  }
</style>
