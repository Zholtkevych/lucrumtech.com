---
import LogoMark from './LogoMark.astro';
import { cleanPath } from '../lib/path';
import { LOCALES, LOCALE_LABELS, DEFAULT_LOCALE, localePath, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  locale?: Locale;
  /** Locale-independent path of this page, e.g. '/services'. Drives the switcher. */
  basePath?: string;
}
const { locale = DEFAULT_LOCALE, basePath = '/' } = Astro.props;

const t = UI[locale];
const path = cleanPath(Astro.url.pathname);
const isOn = (route: string) => path === localePath(locale, route);

const links = [
  { route: '/', label: t.nav.home },
  { route: '/services', label: t.nav.services },
  { route: '/ai', label: t.nav.ai },
  { route: '/work', label: t.nav.work },
  { route: '/about', label: t.nav.about },
  { route: '/contact', label: t.nav.contact },
];
---
<header><div class="wrap"><nav>
  <a class="logo" href={localePath(locale, '/')}><span class="mark" aria-hidden="true"><LogoMark /></span>LucrumTech</a>
  <button class="navtoggle" id="navtoggle" type="button" aria-expanded="false" aria-controls="navlinks" aria-label={t.menu}>
    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>
  <div class="navlinks" id="navlinks">
    {links.map((l) => (
      <a href={localePath(locale, l.route)} class={isOn(l.route) ? 'on' : undefined} aria-current={isOn(l.route) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a class={`navcrisis${isOn('/interim') ? ' on' : ''}`} href={localePath(locale, '/interim')} aria-current={isOn('/interim') ? 'page' : undefined}>{t.nav.interim}</a>

    <div class="navlang" role="group" aria-label={t.language}>
      {LOCALES.map((l) => (
        <a
          href={localePath(l, basePath)}
          class={l === locale ? 'on' : undefined}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'true' : undefined}
        >{l.toUpperCase()}</a>
      ))}
    </div>
  </div>
</nav></div></header>

<noscript>
  <style>
    /* Without JS the toggle can't open the panel, so fall back to a wrapping
       nav that grows the header instead of hiding links behind a dead button. */
    @media (max-width:640px){
      .navtoggle{display:none !important}
      #navlinks{display:flex !important; position:static !important; flex-direction:row !important;
        flex-wrap:wrap; padding:0 0 12px !important; border:0 !important; box-shadow:none !important}
      #navlinks a{border-bottom:0 !important; padding:4px 0 !important; width:auto !important; margin-right:16px}
      nav{height:auto !important; min-height:64px; flex-wrap:wrap; padding:10px 0}
      .navcrisis{margin-left:0 !important; padding-left:0 !important; border-left:0 !important}
      .navlang{margin-left:0 !important; padding-left:0 !important; border-left:0 !important; border-top:0 !important}
    }
  </style>
</noscript>

<script is:inline>
  (function () {
    const btn = document.getElementById('navtoggle');
    const panel = document.getElementById('navlinks');
    if (!btn || !panel) return;

    const setOpen = (open) => {
      panel.classList.toggle('open', open);
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };

    btn.addEventListener('click', () => setOpen(!panel.classList.contains('open')));
    panel.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    window.addEventListener('resize', () => { if (window.innerWidth > 640) setOpen(false); });
  })();
</script>
