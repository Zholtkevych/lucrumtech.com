---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact — LucrumTech"
  description="Tell us what you're building. Thirty minutes — we'll ask what you're solving, who it's for, and what's blocking it, and tell you honestly how we'd approach it."
>
  <section>
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Tell us what you're building.</h1>
      <p class="lede" style="margin-top:24px">Thirty minutes. We'll ask what you're solving, who it's for, and what's blocking it — and tell you honestly how we'd approach it. No deck.</p>
      <form class="form" id="contact-form" method="POST" action="/api/website/send-email" novalidate>
        <label for="f-name">Name</label>
        <input id="f-name" name="name" type="text" placeholder="Your name" autocomplete="name" required>
        <label for="f-email">Email</label>
        <input id="f-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required>
        <label for="f-msg">Message</label>
        <textarea id="f-msg" name="message" rows="5" placeholder="What are you building, or what's broken?" required></textarea>
        <p class="hp-field" aria-hidden="true">
          <label for="f-ref">Reference</label>
          <input id="f-ref" name="reference" type="text" tabindex="-1" autocomplete="off">
        </p>
        <p class="err" id="f-err">Something went wrong sending that — try again, or email us directly.</p>
        <button class="btn" id="f-send" type="submit">Book a strategy call</button>
        <p class="ok" id="f-ok">Thanks — we'll reply within 24 hours.</p>
      </form>
      <p class="meta">hello@lucrumtech.com · Reply within 24 hours</p>
      <p class="sub">In trouble right now? <a href="/interim" style="color:var(--crisis); font-weight:600; cursor:pointer">Talk to us today</a> — we can start within 72 hours.</p>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const err = document.getElementById('f-err') as HTMLParagraphElement;
    const ok = document.getElementById('f-ok') as HTMLParagraphElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.style.display = 'none';
      ok.style.display = 'none';

      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !message) {
        err.textContent = 'Add your name, email and a message.';
        err.style.display = 'block';
        return;
      }

      // Honeypot: real visitors never fill this. Pretend success, send nothing.
      if ((form.elements.namedItem('reference') as HTMLInputElement).value.trim() !== '') {
        ok.style.display = 'block';
        form.reset();
        return;
      }

      const sendBtn = document.getElementById('f-send') as HTMLButtonElement;
      sendBtn.disabled = true;

      try {
        // The email-api expects multipart/form-data (FastAPI Form fields).
        const body = new FormData();
        body.append('name', name);
        body.append('email', email);
        body.append('message', message);

        const res = await fetch(form.action, { method: 'POST', body });

        if (!res.ok) throw new Error('send failed');

        ok.style.display = 'block';
        form.reset();
      } catch {
        err.textContent = 'Something went wrong sending that — try again, or email us directly.';
        err.style.display = 'block';
      } finally {
        sendBtn.disabled = false;
      }
    });

    ['f-name', 'f-email', 'f-msg'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => {
        err.style.display = 'none';
      });
    });
  </script>
</Layout>
