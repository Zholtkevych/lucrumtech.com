---
import Layout from '../../layouts/Layout.astro';
import { localeParams, alternatesFor, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props as { locale: Locale };
const c = (await import(`../../content/${locale}/about.json`)).default;
---
<Layout title={c.title} description={c.description} lang={locale} basePath="/about" alternates={alternatesFor('/about')}>
  <section>
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}<span class="muted">{c.h1Muted}</span></h1>
      <p class="lede" style="margin-top:24px">{c.lede}</p>
      <div style="margin-top:20px">
        {c.people.map((p) => (
          <div class="person"><div><h3>{p.name} <span>{p.role}</span></h3><p>{p.bio}</p></div></div>
        ))}
      </div>
      <p class="sub" style="margin-top:26px">{c.note}</p>
    </div>
  </section>
</Layout>
