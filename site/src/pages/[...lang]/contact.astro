---
import Layout from '../../layouts/Layout.astro';
import { localeParams, alternatesFor, localePath, type Locale } from '../../i18n/config';
import { UI } from '../../i18n/ui';

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props as { locale: Locale };
const c = (await import(`../../content/${locale}/contact.json`)).default;
const f = UI[locale].form;
---
<Layout title={c.title} description={c.description} lang={locale} basePath="/contact" alternates={alternatesFor('/contact')}>
  <section>
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="lede" style="margin-top:24px">{c.lede}</p>
      <form class="form" id="contact-form" method="POST" action="/api/website/send-email" novalidate>
        <label for="f-name">{f.name}</label>
        <input id="f-name" name="name" type="text" placeholder={f.namePlaceholder} autocomplete="name" required>
        <label for="f-email">{f.email}</label>
        <input id="f-email" name="email" type="email" placeholder={f.emailPlaceholder} autocomplete="email" required>
        <label for="f-msg">{f.message}</label>
        <textarea id="f-msg" name="message" rows="5" placeholder={f.messagePlaceholder} required></textarea>
        <p class="hp-field" aria-hidden="true">
          <label for="f-ref">Reference</label>
          <input id="f-ref" name="reference" type="text" tabindex="-1" autocomplete="off">
        </p>
        <p class="err" id="f-err" data-missing={f.missing} data-failed={f.failed}>{f.failed}</p>
        <button class="btn" id="f-send" type="submit">{f.submit}</button>
        <p class="ok" id="f-ok">{f.ok}</p>
      </form>
      <p class="meta">{c.meta}</p>
      <p class="sub">{c.urgentBefore}<a href={localePath(locale, '/interim')} style="color:var(--crisis); font-weight:600; cursor:pointer">{c.urgentLink}</a>{c.urgentAfter}</p>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const err = document.getElementById('f-err') as HTMLParagraphElement;
    const ok = document.getElementById('f-ok') as HTMLParagraphElement;
    const MISSING = err.dataset.missing!;
    const FAILED = err.dataset.failed!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.style.display = 'none';
      ok.style.display = 'none';

      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !message) {
        err.textContent = MISSING;
        err.style.display = 'block';
        return;
      }

      // Honeypot: real visitors never fill this. Pretend success, send nothing.
      if ((form.elements.namedItem('reference') as HTMLInputElement).value.trim() !== '') {
        ok.style.display = 'block';
        form.reset();
        return;
      }

      const sendBtn = document.getElementById('f-send') as HTMLButtonElement;
      sendBtn.disabled = true;

      try {
        // The email-api expects multipart/form-data (FastAPI Form fields).
        const body = new FormData();
        body.append('name', name);
        body.append('email', email);
        body.append('message', message);

        const res = await fetch(form.action, { method: 'POST', body });

        if (!res.ok) throw new Error('send failed');

        ok.style.display = 'block';
        form.reset();
      } catch {
        err.textContent = FAILED;
        err.style.display = 'block';
      } finally {
        sendBtn.disabled = false;
      }
    });

    ['f-name', 'f-email', 'f-msg'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => {
        err.style.display = 'none';
      });
    });
  </script>
</Layout>
