---
import Layout from '../../layouts/Layout.astro';
import { localeParams, alternatesFor, localePath, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props as { locale: Locale };
const c = (await import(`../../content/${locale}/ai.json`)).default;
const contact = localePath(locale, '/contact');
---
<Layout title={c.title} description={c.description} lang={locale} basePath="/ai" alternates={alternatesFor('/ai')}>
  <section>
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}<span class="muted">{c.h1Muted}</span></h1>
      <p class="lede" style="margin-top:24px">{c.lede}</p>
      <p class="lede">{c.lede2}</p>
      <div class="btnrow"><a class="btn" href={contact}>{c.cta}</a></div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">{c.gap.eyebrow}</p>
      <h2>{c.gap.h2}</h2>
      <p class="lede" style="margin-top:22px">{c.gap.body}</p>
      <p class="lede strong">{c.gap.strong}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">{c.build.eyebrow}</p>
      <h2>{c.build.h2}</h2>
      <div class="grid2">
        {c.build.blocks.map((b) => (
          <div class="blk">
            <h3>{b.h3}</h3>
            <p>{b.p}</p>
            <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="wrap">
      <p class="eyebrow">{c.proof.eyebrow}</p>
      <h2>{c.proof.h2}</h2>
      <p class="lede" style="margin-top:22px">{c.proof.body}</p>
      <p style="margin-top:28px"><a class="btn btn-quiet" href={localePath(locale, '/work')}>{c.proof.cta}</a></p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">{c.scope.eyebrow}</p>
      <h2>{c.scope.h2}</h2>
      <p class="lede" style="margin-top:22px">{c.scope.body}</p>
      <div class="btnrow"><a class="btn" href={contact}>{c.scope.cta}</a></div>
      <p class="meta">{c.scope.meta}</p>
    </div>
  </section>
</Layout>
